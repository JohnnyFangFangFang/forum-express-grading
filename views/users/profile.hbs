<div class="card mb-4">
  <div class="row g-0">
    <div class="col-md-4 p-3 text-center">
      {{#if user.image}}
        <img class="img-fluid rounded" src="{{user.image}}" alt="{{user.name}}" style="max-height: 250px;">
      {{else}}
        <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center"
          style="height: 200px;">No Image</div>
      {{/if}}
    </div>
    <div class="col-md-8">
      <div class="card-body">
        <h3 class="card-title">{{user.name}}</h3>
        <p class="card-text">{{user.email}}</p>
        {{#ifCond user.id loginUser.id}}
          <a class="btn btn-primary" href="/users/{{user.id}}/edit">Edit Profile</a>
        {{/ifCond}}
      </div>
    </div>
  </div>
</div>
<div class="card mb-4">
  <div class="card-header">
    <strong>{{commentedRestaurants.length}}</strong> 間評論過的餐廳（共 {{commentCount}} 則評論）
  </div>
  <div class="card-body">
    {{#if commentedRestaurants.length}}
      <div class="row">
        {{#each commentedRestaurants}}
          <div class="col-6 col-md-2 mb-3 text-center">
            <a href="/restaurants/{{this.id}}">
              <img class="img-fluid rounded mb-1" src="{{this.image}}" alt="{{this.name}}">
              <div class="small text-truncate">{{this.name}}</div>
            </a>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="text-muted mb-0">還沒有評論過任何餐廳</p>
    {{/if}}
  </div>
</div>
<a class="btn btn-outline-secondary" href="javascript:history.back()">Back</a>
