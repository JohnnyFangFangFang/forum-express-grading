{{!-- 個人資料 --}}
<div class="card mb-4">
  <div class="row g-0">
    <div class="col-md-4 p-3 text-center">
      {{#if user.image}}
        <img class="img-fluid rounded" src="{{user.image}}" alt="{{user.name}}" style="max-height: 250px;">
      {{else}}
        <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center"
          style="height: 200px;">No Image</div>
      {{/if}}
    </div>
    <div class="col-md-8">
      <div class="card-body">
        <h3 class="card-title">{{user.name}}</h3>
        <p class="card-text">{{user.email}}</p>
        <ul class="list-unstyled">
          <li><strong>{{commentedRestaurants.length}}</strong> 間評論過的餐廳（共 {{commentCount}} 則評論）</li>
          <li><strong>{{favoritedRestaurants.length}}</strong> 間收藏的餐廳</li>
          <li><strong>{{followings.length}}</strong> 位追蹤中</li>
          <li><strong>{{followers.length}}</strong> 位追蹤者</li>
        </ul>
        {{#if isSelf}}
          <a class="btn btn-primary" href="/users/{{user.id}}/edit">Edit Profile</a>
        {{else}}
          {{#if isFollowed}}
            <form action="/following/{{user.id}}?_method=DELETE" method="POST" style="display: contents;">
              <button type="submit" class="btn btn-danger">取消追蹤</button>
            </form>
          {{else}}
            <form action="/following/{{user.id}}" method="POST" style="display: contents;">
              <button type="submit" class="btn btn-primary">追蹤</button>
            </form>
          {{/if}}
        {{/if}}
      </div>
    </div>
  </div>
</div>

<div class="row">
  {{!-- 左欄：人 --}}
  <div class="col-md-4">
    <div class="card mb-4">
      <div class="card-header"><strong>{{followings.length}}</strong> 位追蹤中</div>
      <div class="card-body">
        {{> profile-users users=followings emptyText='還沒有追蹤任何人'}}
      </div>
    </div>
    <div class="card mb-4">
      <div class="card-header"><strong>{{followers.length}}</strong> 位追蹤者</div>
      <div class="card-body">
        {{> profile-users users=followers emptyText='還沒有人追蹤'}}
      </div>
    </div>
  </div>

  {{!-- 右欄：餐廳 --}}
  <div class="col-md-8">
    <div class="card mb-4">
      <div class="card-header">
        <strong>{{commentedRestaurants.length}}</strong> 間評論過的餐廳（共 {{commentCount}} 則評論）
      </div>
      <div class="card-body">
        {{> profile-restaurants restaurants=commentedRestaurants emptyText='還沒有評論過任何餐廳'}}
      </div>
    </div>
    <div class="card mb-4">
      <div class="card-header"><strong>{{favoritedRestaurants.length}}</strong> 間收藏的餐廳</div>
      <div class="card-body">
        {{> profile-restaurants restaurants=favoritedRestaurants emptyText='還沒有收藏任何餐廳'}}
      </div>
    </div>
  </div>
</div>
<a class="btn btn-outline-secondary" href="javascript:history.back()">Back</a>
